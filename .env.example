# Copy to .env (git-ignored) and fill in. A free key comes from https://aistudio.google.com
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# GEMINI_TIMEOUT_S=25        # per-request limit; the SDK has none by default
# GEMINI_MAX_RETRIES=1       # retries on 429/500/503 only
# LOG_LEVEL=INFO             # DEBUG adds tier-2 top-k and prompt sizes to the run log
